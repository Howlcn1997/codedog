{
  "name": "codedog",
  "version": "0.3.4",
  "private": true,
  "type": "module",
  "description": "A quiet home for all your projects",
  "author": "codedog",
  "repository": "https://github.com/Howlcn1997/codedog",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run build:native && tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "pack": "npm run build && node scripts/package.mjs --dir",
    "dist": "npm run build && node scripts/package.mjs",
    "release:mac": "npm run build && electron-builder --mac dmg zip --publish never",
    "format": "prettier --write src electron scripts tests vite.config.ts tsconfig.json package.json docs README.md",
    "build:native": "node scripts/build-native.mjs",
    "predev": "npm run build:native",
    "prestart": "npm run build:native"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@radix-ui/react-dialog": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "lucide-react": "latest",
    "mermaid": "^12.0.0",
    "node-api-headers": "1.9.0",
    "prettier": "^3.9.6",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "simple-icons": "^16.30.0",
    "typescript": "latest",
    "vite": "latest"
  },
  "build": {
    "appId": "dev.codedog.desktop",
    "productName": "codedog",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "public/icon.png",
      "public/ide-icons/*.png",
      "public/ide-icons/README.md",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "public/icon.png",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/icon.png"
    },
    "asarUnpack": [
      "electron/native/*.node"
    ]
  }
}

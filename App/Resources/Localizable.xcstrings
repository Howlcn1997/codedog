    "%@ 已存在且不是 codedog 安装的，为了安全不会覆盖。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ already exists and wasn’t installed by codedog, so it won’t be overwritten for safety."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已存在且不是 codedog 安裝的，為了安全不會覆寫。"
